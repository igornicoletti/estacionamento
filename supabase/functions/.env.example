# Variáveis privadas das Edge Functions.
# Configure remotamente com `supabase secrets set --env-file <arquivo>`.
# Nunca use o prefixo VITE_ nem registre valores reais neste arquivo.

# Supabase fornece estas variáveis no runtime hospedado.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace_with_local_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_local_service_role_key

# Origens autorizadas e identificação interna.
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://estacionamento.redemontecarlo.com.br
APP_HMAC_SECRET=replace_with_strong_random_secret
CPF_HMAC_SECRET=replace_with_strong_random_secret
APP_TECHNICAL_EMAIL_DOMAIN=usuarios.redemontecarlo.internal

# Integração ERP service-to-service.
ERP_BASE_URL=https://erp.example.internal
ERP_API_TOKEN=
ERP_BEARER_TOKEN=
ERP_BASIC_USERNAME=
ERP_BASIC_PASSWORD=
ERP_REQUEST_TIMEOUT_MS=15000
ERP_REQUEST_MAX_ATTEMPTS=3
ERP_REQUEST_RETRY_BASE_DELAY_MS=250
ERP_UNITS_ENDPOINT=/units
ERP_UNITS_UPDATED_SINCE_PARAM=updated_since
ERP_CLIENTS_ENDPOINT=/clients
ERP_CLIENTS_UPDATED_SINCE_PARAM=updated_since
ERP_CLIENT_VEHICLES_ENDPOINT=/client-vehicles
ERP_CLIENT_VEHICLES_UPDATED_SINCE_PARAM=updated_since
